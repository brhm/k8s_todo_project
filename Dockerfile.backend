FROM php:8.4-apache

LABEL maintainer="brhmkskn04@gmail.com"
LABEL description="Apache / PHP development environment"

# System packages + PHP extension dependencies
RUN apt-get update && apt-get install -y \
    nano \
    locales \
    libpng-dev \
    libzip-dev \
    libxml2-dev \
    libonig-dev \
    libsqlite3-dev \
    && docker-php-ext-install \
        bcmath \
        gd \
        mysqli \
        pdo_mysql \
        pdo_sqlite \
        mbstring \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Locales
RUN echo "fr_FR.UTF-8 UTF-8" >> /etc/locale.gen \
    && echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen \
    && echo "de_DE.UTF-8 UTF-8" >> /etc/locale.gen \
    && locale-gen

# PHP development configuration
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini" \
    && sed -i 's/^error_reporting = .*/error_reporting = E_ALL/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/^display_errors = .*/display_errors = On/' "$PHP_INI_DIR/php.ini"

ENV TERM=xterm

# Apache configuration
RUN a2enmod rewrite \
    && echo "ServerName localhost" >> /etc/apache2/apache2.conf \
    && sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ \
        s/AllowOverride None/AllowOverride All/' \
        /etc/apache2/apache2.conf

# Permissions
RUN chgrp -R www-data /var/www \
    && find /var/www -type d -exec chmod 775 {} \; \
    && find /var/www -type f -exec chmod 664 {} \;

EXPOSE 80

COPY ./api/ /var/www/html/
RUN rm -f /var/www/html/index.html

CMD ["apache2-foreground"]